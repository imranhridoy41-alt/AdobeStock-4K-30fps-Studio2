# Rename this file to .env and place it next to AdobeStock-4K-30fps-Studio.exe
# Supports single key (GEMINI_API_KEY) OR multiple keys with automatic rotation (GEMINI_API_KEYS or GEMINI_API_KEY_1..N)

GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Optional: Multi-key rotation pool (comma-separated) for Batch 50 automation
# GEMINI_API_KEYS=YOUR_KEY_1,YOUR_KEY_2,YOUR_KEY_3
